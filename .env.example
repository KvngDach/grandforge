# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Lichess OAuth ───────────────────────────────────────────────────────────
# Create your app at: https://lichess.org/account/oauth/app
# Set the redirect URI to: https://your-project.vercel.app/callback
# (For local dev, also add: http://localhost:5173/callback)
VITE_LICHESS_CLIENT_ID=grandforge

# ─── Redirect URI ────────────────────────────────────────────────────────────
# LOCAL:      http://localhost:5173/callback
# PRODUCTION: https://your-project.vercel.app/callback
VITE_REDIRECT_URI=http://localhost:5173/callback
